---
import GameHero from "../components/home/GameHero.astro";
import PageCollection from "../components/home/PageCollection.astro";
import WikiCategories from "../components/home/WikiCategories.astro";
import { buildHomepageModel } from "../components/home/home-model";
import GameMedia from "../components/media/GameMedia.astro";
import ScreenshotGallery from "../components/media/ScreenshotGallery.astro";
import FAQ from "../components/wiki/FAQ.astro";
import RelatedPages from "../components/wiki/RelatedPages.astro";
import Sources from "../components/wiki/Sources.astro";
import {
  enabledPageCatalog,
  featuredHomepagePages,
  getPageByRoute,
  getRelatedPages,
  siteConfig,
} from "../core/site-data";
import { homepageFaq, homepageQuickFacts } from "../core/p0-static-wiki-copy";
import { mediaCatalog } from "../data/media/catalog";
import BaseLayout from "../layouts/BaseLayout.astro";

const page = getPageByRoute("/");
const relatedPages = getRelatedPages(page);
const homepage = buildHomepageModel({
  enabledPages: enabledPageCatalog,
  featuredPages: featuredHomepagePages,
  quickFacts: homepageQuickFacts,
  faq: homepageFaq,
  media: mediaCatalog.getPageMedia(page.pageId),
});
const hasHomepageMedia =
  homepage.media.galleryMedia.length > 0 || Boolean(homepage.media.trailerMedia);
const steamStoreUrl = "https://store.steampowered.com/app/4892010/Bomb_Farm/";
---

<BaseLayout page={page}>
  <main
    id="main-content"
    class="wiki-portal"
    data-pagefind-body={page.indexability === "index" ? true : undefined}
  >
    <GameHero
      page={page}
      brand={siteConfig.brand}
      startPage={homepage.heroStartPage}
      heroMedia={homepage.media.heroMedia}
      browseTarget={homepage.categories.length > 0 ? "#browse-by-category" : undefined}
      steamUrl={steamStoreUrl}
      quickFacts={homepage.quickFacts}
    />

    <WikiCategories pages={homepage.categories} />

    {hasHomepageMedia && (
      <section
        id="home-media"
        class="portal-section home-media shell"
        aria-labelledby="home-media-title"
      >
        <header class="portal-section__header">
          <p class="eyebrow">Mine, build, rotate</p>
          <div>
            <h2 id="home-media-title">How the game fits together</h2>
            <p class="portal-section__intro">
              Follow the mine route, turn drops into stronger gear, and rotate
              squads so progression keeps moving.
            </p>
          </div>
        </header>
        <div class="home-media__content">
          {homepage.media.galleryMedia.length > 0 && (
            <div data-media-placement="gallery">
              <ScreenshotGallery assets={homepage.media.galleryMedia} />
            </div>
          )}
          {homepage.media.trailerMedia && (
            <div class="home-trailer">
              <div class="home-trailer__heading">
                <p class="eyebrow">Official trailer</p>
                <h3>See the mine in motion</h3>
              </div>
              <div data-media-placement="trailer">
                <GameMedia asset={homepage.media.trailerMedia} />
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <PageCollection
      id="featured-guides"
      eyebrow="Selected routes"
      title="Featured guides"
      pages={homepage.featuredGuides}
    />

    <PageCollection
      id="important-systems"
      eyebrow="Core reference"
      title="Important systems"
      pages={homepage.importantSystems}
    />

    <PageCollection
      id="latest-updates"
      eyebrow="What changed"
      title="Latest updates"
      pages={homepage.latestUpdates}
      showUpdatedAt
    />

    {homepage.faq.length > 0 && (
      <div class="shell">
        <FAQ items={homepage.faq} title="Common questions" />
      </div>
    )}

    <PageCollection
      id="browse-all"
      eyebrow="More to explore"
      title="Browse all"
      pages={homepage.browseAll}
      showDescriptions={false}
    />

    <div class="shell">
      <RelatedPages pages={relatedPages} />
      <Sources sources={page.sources} />
    </div>
  </main>
</BaseLayout>
